# GameDay Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# GOOGLE MAPS (Required for Campus Map)
# ===========================================
# Get your API key from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ===========================================
# OPENAI (Optional - for AI Assistant)
# ===========================================
# Get your API key from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here

# ===========================================
# ESPN API (Public - no key required)
# ===========================================
# These are ESPN's public endpoints, no authentication needed
# You can customize these if using a proxy or different sport
VITE_ESPN_BASE_URL=https://site.api.espn.com/apis/site/v2/sports/football/college-football
VITE_ESPN_CORE_URL=https://sports.core.api.espn.com/v2/sports/football/leagues/college-football

# ===========================================
# APP CONFIGURATION
# ===========================================
# App name displayed in the UI
VITE_APP_NAME=GameDay

# Default sport (college-football, nfl, nba, etc.)
VITE_DEFAULT_SPORT=college-football

# Auto-refresh interval for live scores (in milliseconds)
VITE_REFRESH_INTERVAL=60000




# Google sign-in (optional). OAuth "Web application" Client ID from
# https://console.cloud.google.com/apis/credentials . The "Continue with Google"
# button only appears when this is set. Add each site the app runs on under
# "Authorized JavaScript origins" (e.g. https://kebson.com, http://localhost:5173).
# A Client ID is public (not a secret), so it is safe in a front-end build.
VITE_GOOGLE_CLIENT_ID=

# Cloud accounts (Supabase). When set, accounts and personal data sync across
# devices; when empty, accounts stay on the device. Production values are in
# .env.production (public by design; row-level security protects the data).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
